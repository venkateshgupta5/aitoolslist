# Neon PostgreSQL (pooled connection string)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth (Auth.js)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Canonical site origin (used for SEO metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL="https://aitoolslist.ai"

# Dodo Payments (Merchant of Record). Use a dodo_test_ key in development.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"   # test_mode | live_mode
DODO_PAYMENTS_WEBHOOK_KEY=""            # from the Dodo webhook settings
DODO_LISTING_PRODUCT_ID=""             # Dodo product id for the $199 listing
NEXT_PUBLIC_DODO_MODE="test"           # client-visible checkout mode: test | live
